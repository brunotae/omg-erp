{%- comment -%} OMG · ícones de redes no rodapé (Instagram e WhatsApp). Ícone só aparece se o link estiver preenchido. {%- endcomment -%}
<div class="omg-redes" {{ block.shopify_attributes }}>
  {%- if block.settings.instagram != blank -%}
    <a href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram da OMG" class="omg-redes__ig">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg>
    </a>
  {%- endif -%}
  {%- if block.settings.whatsapp != blank -%}
    {%- assign zap = block.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
    <a href="https://wa.me/{{ zap }}?text={{ 'Olá! Vim pelo site da OMG e quero tirar uma dúvida.' | url_encode }}" target="_blank" rel="noopener" aria-label="WhatsApp da OMG" class="omg-redes__wa">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.5.7 4.9 2 7L3 29l6.6-2.2c2 1.1 4.2 1.7 6.4 1.7 7 0 12.7-5.7 12.7-12.7S23 3 16 3zm0 23.2c-2 0-4-.6-5.7-1.7l-.4-.2-3.9 1.3 1.3-3.8-.3-.4c-1.2-1.8-1.9-3.9-1.9-6 0-5.8 4.8-10.5 10.7-10.5s10.6 4.7 10.6 10.5S21.9 26.2 16 26.2zm5.8-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.1 1.4 3.4c.2.2 2.3 3.5 5.6 4.9 2.8 1.1 3.3.9 3.9.8.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
    </a>
  {%- endif -%}
</div>
<style>
  .omg-redes{display:flex;gap:10px;margin-top:4px}
  .omg-redes a{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;transition:transform .15s}
  .omg-redes a:hover{transform:translateY(-2px)}
  .omg-redes svg{width:21px;height:21px}
  .omg-redes__ig{background:radial-gradient(circle at 30% 107%,#fdf497 0%,#fd5949 45%,#d6249f 60%,#285AEB 90%)}
  .omg-redes__wa{background:#25D366}
</style>
{% schema %}
{
  "name": "OMG · Redes sociais",
  "settings": [
    { "type": "url", "id": "instagram", "label": "Link do Instagram" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (com DDI e DDD)", "default": "5511993049122" }
  ],
  "presets": [{ "name": "OMG · Redes sociais" }]
}
{% endschema %}
