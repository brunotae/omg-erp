  .omg-tom-leg{margin:6px 0 0;font-size:12px;color:#8a7480;line-height:1.45}
  .omg-tom-leg b{color:#4A2638}
  .omg-tom-sel{display:flex;align-items:center;gap:10px;margin:10px 0 0;font-size:13px;color:#4A2638}
  .omg-tom-sel:empty{display:none}
  .omg-tom-sel i{width:34px;height:34px;border-radius:50%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.14);flex:none}
</style>
