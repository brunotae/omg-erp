-me":"#b93046","22-snowy-peach":"#fea28c","23-peachricot":"#f98d86","24-lovably":"#ff93a3","25-nutty-pink":"#f09793","26-bareble":"#ea847a","27-muty-rose":"#cb4e5c","28-wintery":"#ffb2c6","29-eveny":"#d98090","30-mauve-blush":"#a94d6d","03-sand-mond":"#b24c53","01-clear":"#F6EBE4","02-pearl":"#F9F1EA"},"beauty-of-joseon":{"15c":"#EBD1C4","17n":"#EBCFBB","21w":"#EBD1B8","23n":"#EECDB6","25w":"#DDB89A","29n":"#D1AE94","33n":"#C89A72","35n":"#A6815F","39w":"#B1815F","43w":"#A06F4E","45n":"#8A5D43","47n":"#7E5B50","51n":"#6A4841","54n":"#553B33","59n":"#493833"}}, V={{ product.vendor | handleize | json }};
  var mapa=C[V]||null; if(!mapa)return;
  var norm=function(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')};
  var cor=function(v){var k=norm(v);if(mapa[k])return mapa[k];var m=k.match(/^(\d+(?:-\d)?)-?([cnwo])\b/);if(m&&mapa[m[1]+m[2]])return mapa[m[1]+m[2]];return null};
  function pinta(){
    document.querySelectorAll('variant-picker fieldset').forEach(function(f){
      var lg=f.querySelector('legend');if(!lg||!/cor|tom|shade/i.test(lg.textContent))return;
      var L=[].slice.call(f.querySelectorAll('label'));var ins=L.map(function(l){return l.querySelector('input')});
      var hex=ins.map(function(i){return i?cor(i.value):null});var ok=hex.filter(Boolean).length;
      if(ok<2||ok<L.length*0.6)return;
      L.forEach(function(l,ix){var t=l.querySelector('.variant-option__button-label__text')||l;if(!hex[ix]||l.querySelector('.omg-tom'))return;var s=document.createElement('span');s.className='omg-tom';s.style.background=hex[ix];s.setAttribute('aria-hidden','true');t.parentNode.insertBefore(s,t)});
      var sel=f.querySelector('input:checked'),sh=sel&&cor(sel.value);
      var nx=f.nextElementSibling,box=nx&&nx.classList.contains('omg-tom-sel')?nx:null;if(!box){box=document.createElement('div');box.className='omg-tom-sel';f.insertAdjacentElement('afterend',box)}
      var nh=sh?'<i style="background:'+sh+'"></i><span>Tom escolhido: <b>'+sel.value.replace(/</g,'')+'</b></span>':'';if(box.dataset.v!==nh){box.dataset.v=nh;box.innerHTML=nh}
      if(!(box.nextElementSibling&&box.nextElementSibling.classList.contains('omg-tom-leg'))&&ins.some(function(i){return i&&/\d\s?[CNW]\b/i.test(i.value)})){var p=document.createElement('p');p.className='omg-tom-leg';
        p.innerHTML='<b>C</b> = fundo frio (rosado) · <b>N</b> = neutro · <b>W</b> = quente (dourado). Número menor = tom mais claro. A cor da tela é uma referência e pode variar um pouco.';box.insertAdjacentElement('afterend',p)}
    });
  }
  var tm;var obs=new MutationObserver(function(){clearTimeout(tm);tm=setTimeout(pinta,60)});
  function ini(){pinta();var r=document.querySelector('main')||document.body;obs.observe(r,{childList:true,subtree:true})}
  if(document.readyState!=='loading')ini();else document.addEventListener('DOMContentLoaded',ini);
  document.addEventListener('change',function(e){if(e.target.closest&&e.target.closest('variant-picker'))setTimeout(pinta,30)});
})();
</script>
