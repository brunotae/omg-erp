{%- comment -%}
  OMG: lista de produtos em JSON para os blocos de motivação (Compre junto, Complete sua rotina,
  Leve junto, Quem comprou também levou). Renderizada só via Section Rendering API (?section_id=omg-lista).
{%- endcomment -%}
{%- liquid
  assign fonte = blank
  if recommendations.performed
    assign fonte = recommendations.products
  endif
-%}
<script type="application/json" data-omg-lista>
[
{%- if fonte != blank -%}
  {%- for p in fonte -%}
    {%- render 'omg-lista-item', p: p -%}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
{%- elsif collection -%}
  {%- paginate collection.products by 250 -%}
    {%- for p in collection.products -%}
      {%- render 'omg-lista-item', p: p -%}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endpaginate -%}
{%- endif -%}
]
</script>

{% schema %}
{
  "name": "OMG lista (interna)",
  "settings": []
}
{% endschema %}
