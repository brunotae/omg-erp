{%- comment -%} OMG · banner de oferta no meio da página (cupom copiável). {%- endcomment -%}
<section class="omg-bc">
  <div class="omg-bc__caixa" style="--omg-bc1:{{ section.settings.cor_1 }};--omg-bc2:{{ section.settings.cor_2 }}">
    <div class="omg-bc__tx">
      <span class="omg-bc__eti">{{ section.settings.etiqueta }}</span>
      <h2>{{ section.settings.titulo }}</h2>
      <p>{{ section.settings.texto }}</p>
    </div>
    <div class="omg-bc__acoes">
      {%- if section.settings.cupom != blank -%}<button type="button" class="omg-bc__cupom" data-omg-copiar="{{ section.settings.cupom | escape }}">{{ section.settings.cupom }}<small>toque para copiar</small></button>{%- endif -%}
      <a class="omg-bc__btn" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.botao }}</a>
    </div>
  </div>
</section>
<style>
  .omg-bc{max-width:var(--page-width,1400px);margin:0 auto;padding:20px var(--page-margin,16px)}
  .omg-bc__caixa{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:28px clamp(20px,4vw,48px);border-radius:16px;background:linear-gradient(110deg,var(--omg-bc1),var(--omg-bc2));color:#fff}
  .omg-bc__eti{font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.9}
  .omg-bc h2{margin:6px 0 4px;font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;line-height:1.1}
  .omg-bc p{margin:0;font-size:15px;opacity:.92}
  .omg-bc__acoes{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  .omg-bc__cupom{font:inherit;display:flex;flex-direction:column;align-items:center;border:2px dashed rgba(255,255,255,.9);background:rgba(255,255,255,.12);color:#fff;border-radius:12px;padding:8px 18px;font-size:20px;font-weight:800;letter-spacing:.12em;cursor:pointer}
  .omg-bc__cupom small{font-size:11px;font-weight:500;letter-spacing:0;opacity:.85}
  .omg-bc__cupom.ok small::after{content:" · copiado ✓"}
  .omg-bc__btn{background:#fff;color:#B83D66;text-decoration:none;font-weight:800;padding:14px 22px;border-radius:999px}
  @media (max-width:600px){.omg-bc__acoes{width:100%}.omg-bc__btn{flex:1;text-align:center}}
</style>
{% schema %}
{
  "name": "OMG · Banner de cupom",
  "settings": [
    { "type": "text", "id": "etiqueta", "label": "Etiqueta", "default": "Inauguração" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "10% OFF em toda a loja" },
    { "type": "text", "id": "texto", "label": "Texto", "default": "Use o cupom no fechamento do pedido. Válido uma vez por cliente." },
    { "type": "text", "id": "cupom", "label": "Cupom", "default": "INAUGURA10" },
    { "type": "text", "id": "botao", "label": "Botão", "default": "Aproveitar agora" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "cor_1", "label": "Cor 1", "default": "#B83D66" },
    { "type": "color", "id": "cor_2", "label": "Cor 2", "default": "#E07A9B" } ],
  "presets": [{ "name": "OMG · Banner de cupom" }]
}
{% endschema %}
