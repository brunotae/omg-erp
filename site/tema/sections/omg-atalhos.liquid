{%- comment -%} OMG · atalhos redondos (como "Por onde você quer começar", em tamanho compacto). Cada bloco: coleção ou link + imagem opcional. {%- endcomment -%}
<section class="omg-at">
  {%- if section.settings.titulo != blank -%}<h2 class="omg-at__tit">{{ section.settings.titulo }}</h2>{%- endif -%}
  <ul class="omg-at__lista">
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.colecao
        assign url = block.settings.link | default: c.url
        assign nome = block.settings.nome | default: c.title
        assign img = block.settings.imagem | default: c.image
        if img == blank and c != blank
          assign img = c.products.first.featured_image
        endif
      -%}
      <li {{ block.shopify_attributes }}>
        <a href="{{ url }}" class="omg-at__item">
          <span class="omg-at__circ">{%- if img -%}{{ img | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
          <span class="omg-at__nome">{{ nome }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>
<style>
  .omg-at{max-width:var(--page-width,1400px);margin:0 auto;padding:22px var(--page-margin,16px) 6px}
  .omg-at__tit{margin:0 0 14px;font-size:clamp(18px,1.8vw,22px);font-weight:800;color:#2b1520}
  .omg-at__lista{display:flex;gap:clamp(12px,2vw,26px);list-style:none;margin:0;padding:0 0 6px;overflow-x:auto;scrollbar-width:none;justify-content:space-between}
  .omg-at__lista::-webkit-scrollbar{display:none}
  .omg-at__item{display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:#2b1520;width:clamp(76px,9vw,112px)}
  .omg-at__circ{width:100%;aspect-ratio:1;border-radius:50%;background:#FDEEF3;border:2px solid #fff;box-shadow:0 0 0 1px #F4C4D4;overflow:hidden;display:flex;align-items:center;justify-content:center;transition:box-shadow .2s,transform .2s}
  .omg-at__circ img{width:82%;height:82%;object-fit:contain}
  .omg-at__item:hover .omg-at__circ{box-shadow:0 0 0 2px #B83D66;transform:translateY(-2px)}
  .omg-at__nome{font-size:13px;font-weight:600;text-align:center;line-height:1.2}
  @media (max-width:749px){.omg-at__lista{justify-content:flex-start}.omg-at__item{width:76px}.omg-at__nome{font-size:12px}}
</style>

{% schema %}
{
  "name": "OMG · Atalhos redondos",
  "settings": [{ "type": "text", "id": "titulo", "label": "Título", "default": "Por onde você quer começar" }],
  "blocks": [{
    "type": "atalho", "name": "Atalho",
    "settings": [
      { "type": "collection", "id": "colecao", "label": "Coleção" },
      { "type": "url", "id": "link", "label": "Ou link" },
      { "type": "text", "id": "nome", "label": "Nome (se vazio, usa o da coleção)" },
      { "type": "image_picker", "id": "imagem", "label": "Imagem (se vazio, usa a da coleção)" }
    ]
  }],
  "presets": [{ "name": "OMG · Atalhos redondos" }]
}
{% endschema %}
