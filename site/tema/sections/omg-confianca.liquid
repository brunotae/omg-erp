{%- comment -%} OMG · faixa de confiança (4 garantias com ícone). {%- endcomment -%}
<section class="omg-cf">
  <ul class="omg-cf__lista">
    {%- for block in section.blocks -%}
      <li class="omg-cf__item" {{ block.shopify_attributes }}>
        <span class="omg-cf__ic" aria-hidden="true">
          {%- case block.settings.icone -%}
            {%- when 'original' -%}<svg viewBox="0 0 24 24"><path d="M12 2l2.4 2.1 3.2-.3.9 3.1 2.8 1.6-1 3 1 3-2.8 1.6-.9 3.1-3.2-.3L12 22l-2.4-2.1-3.2.3-.9-3.1L2.7 15.5l1-3-1-3 2.8-1.6.9-3.1 3.2.3z"/><path d="M8.5 12.2l2.3 2.3 4.7-4.8"/></svg>
            {%- when 'entrega' -%}<svg viewBox="0 0 24 24"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
            {%- when 'imposto' -%}<svg viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
          {%- endcase -%}
        </span>
        <span class="omg-cf__tx"><b>{{ block.settings.titulo }}</b><small>{{ block.settings.texto }}</small></span>
      </li>
    {%- endfor -%}
  </ul>
</section>
<style>
  .omg-cf{max-width:var(--page-width,1400px);margin:0 auto;padding:18px var(--page-margin,16px) 4px}
  .omg-cf__lista{list-style:none;margin:0;padding:14px 18px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;background:#FFF9FB;border:1px solid #F4E3EA;border-radius:14px}
  .omg-cf__item{display:flex;align-items:center;gap:12px;min-width:0}
  .omg-cf__ic{flex:0 0 40px;height:40px;border-radius:50%;background:#FDEEF3;display:flex;align-items:center;justify-content:center}
  .omg-cf__ic svg{width:21px;height:21px;fill:none;stroke:#B83D66;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round}
  .omg-cf__tx b{display:block;font-size:14px;color:#2b1520;line-height:1.25}
  .omg-cf__tx small{display:block;font-size:12.5px;color:#7a6470;line-height:1.3}
  @media (max-width:989px){.omg-cf__lista{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:500px){.omg-cf__lista{padding:12px;gap:12px}.omg-cf__ic{flex-basis:34px;height:34px}.omg-cf__tx small{font-size:11.5px}}
</style>
{% schema %}
{
  "name": "OMG · Confiança",
  "blocks": [{ "type": "item", "name": "Garantia", "settings": [
    { "type": "select", "id": "icone", "label": "Ícone", "default": "original", "options": [
      { "value": "original", "label": "Selo" }, { "value": "entrega", "label": "Caminhão" }, { "value": "imposto", "label": "Recibo" }, { "value": "seguro", "label": "Cadeado" } ] },
    { "type": "text", "id": "titulo", "label": "Título" },
    { "type": "text", "id": "texto", "label": "Texto" } ] }],
  "presets": [{ "name": "OMG · Confiança" }]
}
{% endschema %}
