{%- comment -%}
  Bomi · chat do site (OMG). Snippet do tema Shopify.
  Instalação: Online Store → Themes → … → Edit code → Snippets → Add a new snippet "bomi-chat",
  cole este arquivo inteiro e, em layout/theme.liquid, logo antes de </body>, acrescente:  {% render 'bomi-chat' %}
  Desligar: apague a linha do render (ou troque BOMI_LIGADA para false abaixo).
{%- endcomment -%}
<div id="bomi-raiz" data-ligada="true"></div>
<style>
  #bomi-raiz{--b-pri:#B83D66;--b-fram:#D9577F;--b-bebe:#FDE4EC;--b-creme:#FFF9F6;--b-ameixa:#4A2638;--b-muted:#7A5566;--b-linha:#F6E2E9;
    position:fixed;right:16px;bottom:16px;z-index:2147483000;font-family:inherit;color:var(--b-ameixa)}
  #bomi-raiz *{box-sizing:border-box}
  #bomi-botao{display:flex;align-items:center;gap:8px;border:0;border-radius:999px;padding:12px 18px 12px 14px;background:var(--b-pri);color:#fff;
    font-family:inherit;font-size:15px;font-weight:600;line-height:1;box-shadow:0 6px 20px rgba(74,38,56,.25);cursor:pointer}
  #bomi-botao:hover{background:var(--b-fram)}
  #bomi-botao .bomi-av{width:26px;height:26px;border-radius:50%;background:#fff;color:var(--b-pri);display:grid;place-items:center;font-size:15px}
  #bomi-janela{position:absolute;right:0;bottom:0;width:min(380px,calc(100vw - 32px));height:min(600px,calc(100vh - 32px));background:var(--b-creme);
    border-radius:18px;box-shadow:0 12px 40px rgba(74,38,56,.3);display:none;flex-direction:column;overflow:hidden;border:1px solid var(--b-linha)}
  #bomi-raiz.aberta #bomi-janela{display:flex}
  #bomi-raiz.aberta #bomi-botao{display:none}
  .bomi-topo{background:var(--b-pri);color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px}
  .bomi-topo b{display:block;font-size:15px}
  .bomi-topo small{opacity:.9;font-size:12px}
  .bomi-topo .bomi-av{width:34px;height:34px;border-radius:50%;background:#fff;color:var(--b-pri);display:grid;place-items:center;font-size:18px;flex:none}
  .bomi-fechar{margin-left:auto;background:none;border:0;color:#fff;font-size:22px;line-height:1;cursor:pointer;padding:4px 8px}
  #bomi-msgs{flex:1;overflow-y:auto;padding:14px 12px;display:flex;flex-direction:column;gap:8px}
  .bomi-l{display:flex}
  .bomi-l.c{justify-content:flex-end}
  .bomi-bolha{max-width:85%;padding:9px 12px;border-radius:16px;font-size:14px;line-height:1.4;white-space:pre-wrap;overflow-wrap:anywhere}
  .bomi-l.b .bomi-bolha{background:#fff;border:1px solid var(--b-linha);border-bottom-left-radius:4px}
  .bomi-l.c .bomi-bolha{background:var(--b-bebe);border-bottom-right-radius:4px}
  .bomi-bolha a{color:var(--b-pri);text-decoration:underline}
  .bomi-digitando{color:var(--b-muted);font-style:italic}
  .bomi-evento{align-self:center;font-size:12px;color:var(--b-muted);background:var(--b-bebe);padding:4px 10px;border-radius:999px}
  .bomi-boas{color:var(--b-muted);font-size:13px;text-align:center;padding:8px 6px}
  .bomi-chips{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:10px}
  .bomi-chips button{border:1px solid var(--b-pri);color:var(--b-pri);background:#fff;border-radius:999px;padding:6px 11px;font-family:inherit;font-size:13px;cursor:pointer}
  .bomi-form{display:flex;gap:6px;padding:10px;border-top:1px solid var(--b-linha);background:#fff;align-items:flex-end}
  .bomi-form textarea{flex:1;resize:none;border:1px solid var(--b-linha);border-radius:14px;padding:9px 12px;font-family:inherit;font-size:14px;line-height:1.35;max-height:96px;
    background:var(--b-creme);color:var(--b-ameixa);min-width:0}
  .bomi-form textarea:focus{outline:2px solid var(--b-fram);outline-offset:0}
  .bomi-bt{flex:none;width:40px;height:40px;border-radius:50%;border:0;display:grid;place-items:center;cursor:pointer;font-size:18px}
  .bomi-enviar{background:var(--b-pri);color:#fff}
  .bomi-enviar:disabled{opacity:.5;cursor:default}
  .bomi-mic{background:var(--b-bebe);color:var(--b-pri)}
  .bomi-mic[aria-pressed="true"]{background:var(--b-pri);color:#fff;animation:bomi-pulso 1.2s infinite}
  @keyframes bomi-pulso{50%{box-shadow:0 0 0 6px rgba(184,61,102,.2)}}
  .bomi-rodape{font-size:11px;color:var(--b-muted);text-align:center;padding:0 10px 8px;background:#fff}
  .bomi-rodape a{color:var(--b-muted)}
  .bomi-nota{display:flex;gap:6px;justify-content:center;font-size:12px;color:var(--b-muted);align-items:center}
  .bomi-nota button{background:none;border:1px solid var(--b-linha);border-radius:999px;padding:2px 8px;cursor:pointer;font-size:14px}
  @media (max-width:480px){
    #bomi-raiz{right:12px;bottom:12px}
    #bomi-raiz.aberta{right:0;bottom:0;left:0;top:0}
    #bomi-raiz.aberta #bomi-janela{width:100%;height:100%;border-radius:0;position:static}
    .bomi-form textarea{font-size:16px}
  }
</style>
<script>
(function () {
  var BOMI_LIGADA = true;
  var URL_BOMI = "https://nzsiuniabovvptuqmkmi.supabase.co/functions/v1/bomi";
  var raiz = document.getElementById("bomi-raiz");
  if (!BOMI_LIGADA || !raiz || window.__bomi) return;
  window.__bomi = true;

  // memória da conversa entre páginas (some quando a aba fecha)
  var mem = {};
  function ler(k) { try { return JSON.parse(sessionStorage.getItem("bomi_" + k)); } catch (e) { return mem[k]; } }
  function gravar(k, v) { mem[k] = v; try { sessionStorage.setItem("bomi_" + k, JSON.stringify(v)); } catch (e) {} }
  function novoId() {
    try { return crypto.randomUUID(); } catch (e) { return Date.now().toString(36) + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2); }
  }
  var sessao = ler("sessao") || novoId(); gravar("sessao", sessao);
  var hist = ler("hist") || [];   // [{p:'c'|'b'|'e', t}]
  var ocupada = false;

  raiz.innerHTML =
    '<button id="bomi-botao" type="button" aria-label="Abrir o chat com a Bomi"><span class="bomi-av" aria-hidden="true">🌸</span>Dúvidas? Fale com a Bomi</button>' +
    '<section id="bomi-janela" role="dialog" aria-label="Chat com a Bomi, assistente virtual da OMG">' +
      '<div class="bomi-topo"><span class="bomi-av" aria-hidden="true">🌸</span><div><b>Bomi</b><small>assistente virtual (IA) da OMG</small></div>' +
      '<button class="bomi-fechar" type="button" aria-label="Fechar o chat">×</button></div>' +
      '<div id="bomi-msgs" aria-live="polite"></div>' +
      '<form class="bomi-form" autocomplete="off">' +
        '<button class="bomi-bt bomi-mic" type="button" aria-label="Falar em vez de digitar" aria-pressed="false" hidden>🎤</button>' +
        '<textarea rows="1" maxlength="800" placeholder="Escreva sua dúvida…" aria-label="Sua mensagem"></textarea>' +
        '<button class="bomi-bt bomi-enviar" type="submit" aria-label="Enviar">➤</button>' +
      '</form>' +
      '<div class="bomi-rodape">Não envie dados de cartão ou senha. <a href="/policies/privacy-policy" target="_blank">Privacidade</a></div>' +
    '</section>';

  var $ = function (s) { return raiz.querySelector(s); };
  var msgs = $("#bomi-msgs"), txt = $("textarea"), btEnviar = $(".bomi-enviar"), btMic = $(".bomi-mic");

  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); }
  function md(t) {
    var h = esc(t).replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");
    return h.replace(/(https:\/\/[^\s<]+[^\s<.,;:!?)])/g, function (u) {
      var interno = /^https:\/\/(www\.)?ohmygirl\.com\.br\//.test(u);
      return '<a href="' + u + '"' + (interno ? "" : ' target="_blank" rel="noopener"') + ">" + u.replace(/^https:\/\/(www\.)?ohmygirl\.com\.br/, "ohmygirl.com.br") + "</a>";
    });
  }
  function rolar() { msgs.scrollTop = msgs.scrollHeight; }
  function bolha(p, t) {
    var d = document.createElement("div");
    if (p === "e") { d.className = "bomi-evento"; d.textContent = t; }
    else { d.className = "bomi-l " + p; d.innerHTML = '<div class="bomi-bolha">' + (p === "b" ? md(t) : esc(t)) + "</div>"; }
    msgs.appendChild(d); rolar(); return d;
  }
  function boasVindas() {
    msgs.innerHTML = '<div class="bomi-boas">Oi! Eu sou a Bomi, assistente virtual da OMG 💗<br>Tiro dúvidas sobre pedidos, entrega, impostos e produtos.' +
      '<div class="bomi-chips"><button type="button">Cadê meu pedido?</button><button type="button">Quanto pago de imposto?</button><button type="button">Me indica um protetor solar</button></div></div>';
    msgs.querySelectorAll(".bomi-chips button").forEach(function (b) { b.addEventListener("click", function () { enviar(b.textContent); }); });
  }
  function desenhar() {
    if (!hist.length) return boasVindas();
    msgs.innerHTML = "";
    hist.forEach(function (m) { bolha(m.p, m.t); });
    if (hist.length >= 6 && !ler("notou")) {
      var n = document.createElement("div"); n.className = "bomi-nota";
      n.innerHTML = 'A Bomi ajudou? <button type="button" data-n="bom" aria-label="Sim">👍</button><button type="button" data-n="ruim" aria-label="Não">👎</button>';
      n.addEventListener("click", function (e) {
        var b = e.target.closest("button"); if (!b) return;
        gravar("notou", true); n.textContent = "Obrigada pelo retorno! 💗";
        fetch(URL_BOMI, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ sessao: sessao, nota: b.dataset.n }) }).catch(function () {});
      });
      msgs.appendChild(n);
    }
    rolar();
  }
  function abrir(sim) {
    raiz.classList.toggle("aberta", sim); gravar("aberta", sim);
    if (sim) { desenhar(); setTimeout(function () { txt.focus(); }, 50); }
  }
  $("#bomi-botao").addEventListener("click", function () { abrir(true); });
  $(".bomi-fechar").addEventListener("click", function () { abrir(false); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && raiz.classList.contains("aberta")) abrir(false); });
  if (ler("aberta") && window.innerWidth > 480) abrir(true);

  function enviar(texto) {
    texto = String(texto || "").trim();
    if (!texto || ocupada) return;
    ocupada = true; btEnviar.disabled = true;
    if (!hist.length) msgs.innerHTML = "";
    hist.push({ p: "c", t: texto }); gravar("hist", hist); bolha("c", texto);
    var dig = bolha("b", "digitando…"); dig.querySelector(".bomi-bolha").classList.add("bomi-digitando");
    var fim = function (partes, transferida) {
      dig.remove();
      if (transferida && !ler("transf")) { gravar("transf", true); hist.push({ p: "e", t: "Conversa passada para a equipe da OMG" }); bolha("e", "Conversa passada para a equipe da OMG"); }
      partes.forEach(function (t) { hist.push({ p: "b", t: t }); bolha("b", t); });
      gravar("hist", hist.slice(-60)); ocupada = false; btEnviar.disabled = false; txt.focus();
    };
    fetch(URL_BOMI, { method: "POST", headers: { "content-type": "application/json" },
      body: JSON.stringify({ sessao: sessao, texto: texto, pagina: location.pathname }) })
      .then(function (r) { return r.json(); })
      .then(function (j) { fim(j.mensagens && j.mensagens.length ? j.mensagens : ["Ops, não consegui responder agora 😕 Tente de novo em instantes."], j.transferida); })
      .catch(function () { fim(["Sem conexão no momento 😕 Tente de novo, ou fale com a equipe: info.br@ohmygirl.com.br."]); });
  }
  $("form").addEventListener("submit", function (e) { e.preventDefault(); var v = txt.value; txt.value = ""; ajustar(); enviar(v); });
  txt.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); $("form").requestSubmit ? $("form").requestSubmit() : $("form").dispatchEvent(new Event("submit", { cancelable: true })); } });
  function ajustar() { txt.style.height = "auto"; txt.style.height = Math.min(txt.scrollHeight, 96) + "px"; }
  txt.addEventListener("input", ajustar);

  // 🎤 ditado (o próprio navegador transcreve; o áudio não vai para a OMG)
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (SR) {
    btMic.hidden = false;
    var rec = null;
    btMic.addEventListener("click", function () {
      if (rec) { rec.stop(); return; }
      rec = new SR(); rec.lang = "pt-BR"; rec.interimResults = true; rec.continuous = false;
      var antes = txt.value ? txt.value.replace(/\s*$/, " ") : "";
      rec.onresult = function (e) {
        var t = ""; for (var i = 0; i < e.results.length; i++) t += e.results[i][0].transcript;
        txt.value = antes + t; ajustar();
      };
      rec.onend = function () { rec = null; btMic.setAttribute("aria-pressed", "false"); txt.focus(); };
      rec.onerror = function () { if (rec) rec.stop(); };
      btMic.setAttribute("aria-pressed", "true");
      try { rec.start(); } catch (e) { rec = null; btMic.setAttribute("aria-pressed", "false"); }
    });
  }
})();
</script>
